// QuickTec — field service time tracking & reporting
//
// Modelling notes that are easy to get wrong later:
//   * Job is shared by everyone on site. JobAssignment is per tech (own external
//     Assignment ID, own pay rate, own signature, own Work Performed).
//   * Visit is a single clock-in/clock-out pair. A job can have several, either
//     because it spans days or because the tech left and came back.
//   * Client-facing totals come from the whole job (earliest in, latest out);
//     pay comes from each tech's own visits minus their unpaid breaks.
//   * All timestamps are UTC. Display uses Site.timeZone, falling back to
//     CompanySettings.defaultTimeZone (America/Los_Angeles).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// People, roles, permissions
// ---------------------------------------------------------------------------

/// Mapped hard from NextCloud groups on every login (quicktec-admin,
/// quicktec-manager, quicktec-supervisor, quicktec-tech, quicktec-accountant).
/// A user in none of those groups is refused entry.
enum BaseRole {
  ADMINISTRATOR
  MANAGER
  SUPERVISOR
  TECH
  ACCOUNTANT
}

/// How far a permission reaches. Checked per permission, not per role.
enum PermissionScope {
  /// Only rows the user owns.
  OWN
  /// OWN plus every tech whose directSupervisor is this user.
  REPORTS
  /// Everything inside projects where the user is PM or supervisor.
  PROJECT
  /// Everything.
  ALL
}

model User {
  id String @id @default(cuid())

  /// OIDC `sub` from NextCloud. Stable across email changes.
  nextcloudSub String? @unique
  email        String  @unique
  name         String
  phone        String?
  avatarUrl    String?

  baseRole BaseRole
  active   Boolean  @default(true)
  timeZone String   @default("America/Los_Angeles")

  /// Always the person who pays this tech, regardless of project membership.
  /// Payroll approval follows this link and nothing else.
  directSupervisorId String?
  directSupervisor   User?   @relation("DirectReports", fields: [directSupervisorId], references: [id], onDelete: SetNull)
  directReports      User[]  @relation("DirectReports")

  /// CalDAV calendar provisioned by the 417-SYS system account.
  calendarUrl  String?
  calendarName String?

  /// Fallback pay rate when no job/project/client rate applies.
  defaultPayType PayType?
  defaultPayRate Decimal? @db.Decimal(10, 2)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissionOverrides   PermissionOverride[]
  projectMemberships    ProjectMember[]
  managedProjects       Project[]            @relation("ProjectManager")
  assignments           JobAssignment[]
  supervisedAssignments JobAssignment[]      @relation("AssignmentSupervisor")
  createdJobs           Job[]                @relation("JobCreatedBy")
  approvedJobs          Job[]                @relation("JobApprovedBy")
  payRates              PayRate[]
  mileageEntries        MileageEntry[]       @relation("MileageOwner")
  payrollPeriods        PayrollPeriod[]      @relation("PayrollTech")
  payrollAsSupervisor   PayrollPeriod[]      @relation("PayrollSupervisor")
  approvedPayrolls      PayrollPeriod[]      @relation("PayrollApprover")
  changeRequests        ChangeRequest[]      @relation("ChangeRequester")
  reviewedChanges       ChangeRequest[]      @relation("ChangeReviewer")
  scopeChecks           JobScopeCheck[]
  uploads               Attachment[]
  auditEvents           AuditEvent[]
  notifications         Notification[]
  raisedNotifications   Notification[]       @relation("NotificationActor")
  pmChanges             ProjectPmChange[]    @relation("PmChangedBy")
  approvedFormEntries   JobFormEntry[]       @relation("FormEntryApprover")
  calendarEvents        CalendarEvent[]

  @@index([baseRole, active])
  @@index([directSupervisorId])
}

/// Editable permission matrix. Seeded with defaults, then owned by Managers.
model RoleGrant {
  id         String          @id @default(cuid())
  role       BaseRole
  permission String
  scope      PermissionScope

  @@unique([role, permission])
}

/// Point grant/revoke on top of the base role, optionally narrowed to a project.
model PermissionOverride {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  /// false = explicit revoke, which beats the role grant.
  granted    Boolean          @default(true)
  /// Ignored when granted = false.
  scope      PermissionScope?
  projectId  String?
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  note       String?

  createdAt DateTime @default(now())

  @@unique([userId, permission, projectId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Company
// ---------------------------------------------------------------------------

/// Single row (id = "singleton"). "Our" company — not the buyer on a job.
model CompanySettings {
  id String @id @default("singleton")

  name    String  @default("QuickTec")
  logoUrl String?

  /// Whether the header reads "<Company> | QuickTec" or just the logo and
  /// QuickTec. A long company name eats the whole bar on a phone, and the logo
  /// already says whose deployment this is.
  showCompanyNameInHeader Boolean @default(true)

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String? @default("USA")
  phone        String?
  email        String?
  website      String?

  /// Drives the "<Company> INT WO ID" field label.
  intWoLabel String @default("INT WO ID")

  defaultTimeZone String @default("America/Los_Angeles")
  currency        String @default("USD")

  /// Clock in/out snaps to this many minutes. Pay is computed from the snapped
  /// time with no further rounding.
  timeRoundingMinutes Int     @default(5)
  /// How far the tech may nudge their own clock time, in minutes.
  techTimeAdjustLimit Int     @default(30)
  breakPaidByDefault  Boolean @default(true)

  mileageRate Decimal @default("0.70") @db.Decimal(10, 4)
  /// Weeks between the end of a pay week and the expected payment date.
  payLagWeeks Int     @default(3)

  maxPhotosPerJob  Int     @default(30)
  /// Bottom-right stamp: YYYY-MM-DD-AssignmentID-Customer-#SiteID
  watermarkEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Clients, customers, sites
// ---------------------------------------------------------------------------

/// The buyer / representing company that dispatches work to us — normally a
/// subcontractor. Exported as "Buyer/Representing company:".
model Client {
  id     String  @id @default(cuid())
  name   String  @unique
  code   String?
  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects         Project[]
  jobs             Job[]
  payRates         PayRate[]
  contacts         ExternalContact[]
  templates        ClientDocumentTemplate[]
  /// Numbers to reach on any job for them — offered when one is raised.
  dispatchContacts DispatchContact[]
}

/// A ticket number beyond the job's primary one.
///
/// One job routinely answers to more than one ticket: the company raises a
/// second under a different queue, or a revisit is tracked separately and the
/// customer wants both quoted back. `Job.ticketNumber` stays the primary — it
/// is what every report, export and change request already means by "the
/// ticket" — and these are the ones after it, in the order they were added.
model JobTicket {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  number String
  /// 0 is the secondary, 1 the one after that. The primary is not in here.
  order  Int    @default(0)

  createdAt DateTime @default(now())

  @@index([jobId, order])
}

/// Which piece of paper an attachment is.
enum JobDocumentKind {
  /// The work order the representing company issued, as they issued it.
  CLIENT_WORK_ORDER
  /// Their sign-off sheet: a blank the tech fills in and gets signed on site.
  SIGN_OFF
}

/// A blank form a representing company always uses.
///
/// The sign-off sheet is nearly always the same document for a given company,
/// and re-uploading it per job is how jobs end up going out on last year's
/// form. Stored once here and copied onto the job when it is raised.
model ClientDocumentTemplate {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind  JobDocumentKind
  label String

  /// Offered with the box already ticked when a job is raised for this company.
  isDefault Boolean @default(false)
  active    Boolean @default(true)

  attachmentId String     @unique
  attachment   Attachment @relation("ClientTemplateFile", fields: [attachmentId], references: [id], onDelete: Cascade)

  /// Where this blank's boxes came from. Set when the file is read on upload.
  boxSource FormBoxSource?

  /// Page geometry in PDF points, read once so the mapping editor and the
  /// filler agree on where a box is without opening the file.
  pageCount  Int?
  pageWidth  Float?
  pageHeight Float?

  /// Boxes on the blank and what goes in each. Empty until someone maps it,
  /// which is what tells the job page whether filling is on offer.
  placements FormPlacement[]

  /// Copies of this blank sitting on jobs, filled and unfilled.
  copies Attachment[] @relation("TemplateCopies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, kind])
}

/// Where a blank's boxes came from.
///
/// Not how it gets filled — filling is the same either way. The filler draws
/// every value onto the page itself and takes the form fields out, because a
/// blank produced by whatever was to hand cannot be relied on to flatten: one
/// of the two real sheets this was built against throws on it, and a form that
/// stays editable after the customer signs it is not a signed form.
enum FormBoxSource {
  /// The PDF declared form fields, so the boxes were read out of the file.
  FIELDS
  /// A flat PDF — the boxes were placed by hand, which is what somebody does
  /// today in a phone annotator every time they fill one of these in.
  DRAWN
}

/// What a placement puts on the page.
enum FormPlacementKind {
  TEXT
  /// A tick when the value is truthy, nothing when it is not.
  CHECK
  /// The signature captured on site, fitted into the box.
  SIGNATURE
}

/// One box on a blank, and the job datum that fills it.
///
/// Seeded from the PDF's own fields where it has them, drawn by hand where it
/// does not. Either way the filler only ever writes where a placement says to:
/// a form that goes to a customer with the wrong value in a box is worse than
/// one that went out empty, so nothing is guessed at fill time.
model FormPlacement {
  id         String                 @id @default(cuid())
  templateId String
  template   ClientDocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  /// The AcroForm field this fills. Null on a flat form, where there is no
  /// field to name and the rectangle is all we have.
  fieldName String?

  /// Zero-based page, and the box in PDF points from its bottom-left corner.
  page   Int   @default(0)
  x      Float
  y      Float
  width  Float
  height Float

  kind FormPlacementKind @default(TEXT)

  /// Key into the catalogue in src/lib/forms/catalogue.ts. Deliberately a
  /// string and not an enum: the set of things a form can ask for grows every
  /// time a company invents a box, and that should not need a migration.
  /// Empty means the box is left for somebody to fill in by hand.
  source String?

  /// The literal text, when source is the static one.
  staticText String?

  /// Which entry a list source refers to — day two of a timesheet is row 1.
  rowIndex Int?

  /// Point size for drawn text. Null lets the filler pick what fits.
  fontSize Float?

  /// What the blank already had in this field, kept as the hint that tells
  /// somebody what "Text19" is for. Not written to any filled form.
  sampleText String?

  order Int @default(0)

  entries JobFormEntry[]

  @@index([templateId, page])
}

/// What a person typed into one box of one job's sheet.
///
/// The mapping fills what the app knows. The rest of a sign-off sheet is
/// somebody's judgement — a travel time, a tick against "site not ready", a
/// phone number we never held — and until now that meant printing the sheet
/// and writing on it. Kept per job so a sheet regenerated after the signature
/// is captured does not lose what was typed the first time.
model JobFormEntry {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  placementId String
  placement   FormPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  /// What somebody typed over the filled value. Null is "not overridden";
  /// empty is "leave this box alone", which is a different thing — a box
  /// deliberately cleared stays cleared rather than filling itself back in.
  value String?

  /// What the box said when it was ticked off, not merely that it was.
  ///
  /// A sheet is checked box by box, and the job underneath keeps moving: a
  /// tech clocks out, a signature arrives, somebody fixes the address. An
  /// approval that survived the value changing would be somebody vouching for
  /// text they never saw, so it is matched against what is in the box now and
  /// quietly lapses when they differ.
  approvedValue String?
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?     @relation("FormEntryApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, placementId])
  @@index([jobId])
}

/// The end brand, e.g. SBUX. Independent of Client because the same customer
/// can arrive through different subcontractors.
model Customer {
  id     String  @id @default(cuid())
  name   String
  /// Short code used in "Site name & ID", e.g. SBUX.
  code   String  @unique
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites    Site[]
  jobs     Job[]
  projects Project[]
}

model Site {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// External store number, e.g. "24541". Combined with customer code as
  /// "SBUX #24541" in exports.
  siteNumber    String
  /// The number is not known yet. Dispatch often reads out a customer and a
  /// city and nothing else; the tech reads the number off the door. The site
  /// still exists so the job has an address and a timezone, and siteNumber
  /// holds a placeholder until somebody replaces it.
  numberPending Boolean @default(false)
  name          String?

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String  @default("USA")
  timeZone     String?

  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@unique([customerId, siteNumber])
  @@index([siteNumber])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  CLOSED
}

enum ProjectRole {
  PROJECT_MANAGER
  SUPERVISOR
  TECH
}

model Project {
  id   String @id @default(cuid())
  name String

  /// Project ID as given by the client. Used verbatim in the INT WO ID.
  /// Null renders as "0000".
  externalProjectId String?

  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  /// The representing company's own project manager or coordinator — their
  /// side, not ours. Copied onto each job as it is created, so replacing them
  /// mid-project leaves the jobs already planned under the person who actually
  /// ran them.
  pmContactId String?
  pmContact   ExternalContact? @relation("ProjectPmContact", fields: [pmContactId], references: [id], onDelete: SetNull)

  /// Markdown/HTML, prepended to each job's own scope.
  generalScopeOfWork String?

  /// Default travel reimbursement for jobs in this project. There is
  /// deliberately no per-tech default for travel.
  travelReimbursement Decimal? @db.Decimal(10, 2)
  breakPaid           Boolean  @default(true)

  /// Prefilled into a new job's title. Work under one project tends to be the
  /// same sentence forty times over.
  defaultJobTitle String?

  /// What this project pays somebody who has no rate of their own on it. Sits
  /// below a tech's project or client rate and above their personal default:
  /// this is the number negotiated for this work, and a personal default is
  /// what applies to work nobody negotiated.
  defaultPayType PayType?
  defaultPayRate Decimal? @db.Decimal(10, 2)

  /// Lifetime counter for INT WO IDs inside this project — never reset.
  intWoCounter Int @default(0)

  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  members             ProjectMember[]
  jobs                Job[]
  deliverableRules    DeliverableRequirement[]
  dispatchContacts    DispatchContact[]
  payRates            PayRate[]
  permissionOverrides PermissionOverride[]
  pmHistory           ProjectPmChange[]
  auditEvents         AuditEvent[]
  notifications       Notification[]

  @@index([clientId])
}

/// Somebody on the other side of the work — the representing company's project
/// manager or coordinator.
///
/// Kept as a directory because the same handful of people come back job after
/// job, and re-typing a phone number from memory is how it ends up wrong. Their
/// details are internal: only the name reaches the client-facing report.
model ExternalContact {
  id    String  @id @default(cuid())
  name  String
  title String?
  phone String?
  email String?
  notes String?

  /// Which representing company they work for, when it is known.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]         @relation("ProjectPmContact")
  jobs      Job[]             @relation("JobPmContact")
  pmChanges ProjectPmChange[]

  @@index([name])
  @@index([clientId])
}

/// Who ran a project, and from when.
///
/// The current PM is on the project; this is the record of how it got there.
/// Without it a mid-project handover would rewrite history, and "who was the
/// coordinator on that job in June" is exactly the question that gets asked.
model ProjectPmChange {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  contactId String?
  contact   ExternalContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  changedById String?
  changedBy   User?   @relation("PmChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  /// Why, when somebody bothered to say. Worth having on a handover.
  reason String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(TECH)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

/// Where the job is in our internal workflow.
enum JobLifecycle {
  DRAFT
  /// Created ad-hoc by a tech; work may proceed, approval is retroactive.
  PENDING_APPROVAL
  SCHEDULED
  IN_PROGRESS
  /// Clocked out, waiting on supervisor review.
  PENDING_REVIEW
  APPROVED
  /// The representing company has paid for it and payroll has been run.
  BILLED
  /// The techs have been paid. Nothing left to do.
  CLOSED
}

/// What the tech reported at checkout. Appears on client-facing exports.
enum JobOutcome {
  COMPLETED
  INCOMPLETE
  FAIL
  CANCEL
}

/// Set afterwards by Direct Supervisor / Project Manager / Manager.
/// Internal only — never exported to the client.
enum JobInternalStatus {
  REVISIT_REQUIRED
  RESCHEDULED
  RESCHEDULE_CANCELLED
}

model Job {
  id String @id @default(cuid())

  /// YYYY-MM-PRJID-NNNN, plus -R<n> for revisits. Month is the revisit's month.
  intWoId       String @unique
  /// The NNNN part on its own. A revisit reuses its parent's sequence, so
  /// generating one never has to parse the string back apart.
  intWoSequence Int

  title String

  /// External ID from the client. One per work order — two techs on the same
  /// job share it. A revisit that reuses the original ID is stored prefixed:
  /// "R-887766"; a revisit issued a genuinely new ID stores that verbatim.
  externalAssignmentId String?

  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  ticketNumber String?
  incNumber    String?

  scheduledStart  DateTime?
  /// Drives the calendar event length until the real clock-out lands.
  estimateMinutes Int?
  techsRequired   Int       @default(1)

  /// Markdown/HTML. Checkbox state lives in JobScopeCheck.
  scopeOfWork String?

  breakPaid Boolean @default(true)

  /// What this job pays, when it is none of the usual sources — a weekend
  /// cutover at overtime, a flat fee agreed on the phone. Null leaves the
  /// normal resolution alone: each tech's own rate, then the project's.
  ///
  /// Kept on the job rather than only copied onto the assignments, so somebody
  /// added tomorrow gets the same decision as somebody added today.
  payType             PayType?
  payRate             Decimal? @db.Decimal(10, 2)
  travelReimbursement Decimal? @db.Decimal(10, 2)

  /// The representing company issued no work order for this job. Recorded so
  /// the empty slot reads as a decision somebody made rather than paperwork
  /// nobody got round to chasing.
  noWorkOrder Boolean @default(false)

  lifecycle      JobLifecycle       @default(DRAFT)
  outcome        JobOutcome?
  internalStatus JobInternalStatus?

  /// When the representing company's money arrived, and when the techs were
  /// paid. Stamped rather than derived so the timeline has something to show
  /// even after a payroll period is rebuilt.
  billedAt DateTime?
  closedAt DateTime?

  /// The representing company's coordinator for this job, copied from the
  /// project when the job was created. A handover on the project does not
  /// rewrite the jobs that ran under the previous one.
  pmContactId String?
  pmContact   ExternalContact? @relation("JobPmContact", fields: [pmContactId], references: [id], onDelete: SetNull)

  /// Filled at checkout. noReleaseCode records an explicit "there isn't one".
  releaseCode          String?
  noReleaseCode        Boolean @default(false)
  returnTrackingNumber String?

  /// Merged narrative assembled by the Lead Tech or Direct Supervisor from the
  /// per-assignment Work Performed entries. Falls back to concatenation.
  workPerformedMerged String?

  /// Revisit chain. A revisit is its own Job pointing back at the original.
  parentJobId   String?
  parentJob     Job?    @relation("JobRevisits", fields: [parentJobId], references: [id], onDelete: SetNull)
  revisits      Job[]   @relation("JobRevisits")
  revisitNumber Int?

  createdById String
  createdBy   User   @relation("JobCreatedBy", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("JobApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  calendarSyncedAt DateTime?
  /// Why the last push failed, cleared when one succeeds. Background syncs are
  /// not awaited by anybody, so without this a calendar that quietly rejects
  /// every event looks exactly like a calendar with nothing to put in it.
  calendarSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments      JobAssignment[]
  dispatchContacts DispatchContact[]
  pointsOfContact  PointOfContact[]
  signatures       Signature[]
  deliverableRules DeliverableRequirement[]
  deliverables     DeliverableItem[]
  reimbursements   Reimbursement[]
  /// Ticket numbers after the first. `ticketNumber` above is the primary one
  /// — the field people mean when they say "the ticket".
  extraTickets     JobTicket[]
  /// The representing company's paperwork: their work order and sign-off blank.
  documents        Attachment[]             @relation("JobDocuments")
  /// What was typed by hand into their sign-off sheet for this job.
  formEntries      JobFormEntry[]
  mileageEntries   MileageEntry[]
  scopeChecks      JobScopeCheck[]
  changeRequests   ChangeRequest[]
  auditEvents      AuditEvent[]
  calendarEvents   CalendarEvent[]
  notifications    Notification[]

  @@index([lifecycle])
  @@index([siteId])
  @@index([projectId])
  @@index([scheduledStart])
}

/// One tech on one job.
model JobAssignment {
  id     String @id @default(cuid())
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Exactly one lead per job. Owns the merged Work Performed. Defaults to the
  /// supervisor on site; whoever assigns the job, or the tech's direct
  /// supervisor, can move it to someone else.
  isLead Boolean @default(false)

  /// Effective approver for this job: project manager when the direct
  /// supervisor is not on the project, otherwise the direct supervisor.
  supervisorId String?
  supervisor   User?   @relation("AssignmentSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  payType             PayType
  payRate             Decimal  @default("0") @db.Decimal(10, 2)
  /// Why this rate, when it is not simply the one that resolved.
  payRateNote         String?
  travelReimbursement Decimal? @db.Decimal(10, 2)
  /// This person is deliberately on a different rate from the rest of the job
  /// — a trainee, somebody brought in on a favour. Setting the job's pay
  /// leaves them alone, which is the whole point of having said so.
  payOverridden       Boolean  @default(false)

  workPerformed String?

  /// Pre-filled checkout data, captured before the tech actually leaves.
  checkoutPrefilledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits         Visit[]
  deliverables   DeliverableItem[]
  reimbursements Reimbursement[]
  signatures     Signature[]
  payrollLines   PayrollLine[]

  @@unique([jobId, userId])
  @@index([userId])
}

enum ClockSource {
  NOW
  ADJUSTED
  MANUAL
}

model Visit {
  id           String        @id @default(cuid())
  assignmentId String
  assignment   JobAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  clockInAt     DateTime
  clockInSource ClockSource @default(NOW)
  /// Unrounded device clock at the moment the button was pressed, kept for audit.
  clockInRawAt  DateTime?

  clockOutAt     DateTime?
  clockOutSource ClockSource?
  clockOutRawAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breaks BreakPeriod[]

  /// One visit per assignment — one job, one tech, one arrival. A genuine
  /// second trip is a revisit job with its own number and its own invoice
  /// line. Enforced by a unique index in the migration rather than here:
  /// marking the column unique would make Prisma read this as one-to-one and
  /// rename the relation across the app for no gain.
  @@index([assignmentId])
  @@index([clockInAt])
}

model BreakPeriod {
  id      String @id @default(cuid())
  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime?
  /// Unpaid breaks are subtracted from pay only. The client is still billed
  /// for the full onsite span.
  paid    Boolean

  createdAt DateTime @default(now())

  @@index([visitId])
}

/// Checkbox state for a "- [ ]" line inside Scope of Work.
model JobScopeCheck {
  id      String @id @default(cuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Line index in the rendered scope, stable per revision.
  lineKey String

  checked     Boolean   @default(false)
  checkedById String?
  checkedBy   User?     @relation(fields: [checkedById], references: [id], onDelete: SetNull)
  checkedAt   DateTime?

  @@unique([jobId, lineKey])
}

// ---------------------------------------------------------------------------
// Contacts & signatures
// ---------------------------------------------------------------------------

/// Quick-dial block. A tech's own supervisor is always injected first at render
/// time, so it is not stored here.
model DispatchContact {
  id        String   @id @default(cuid())
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Held against the representing company as a default, rather than against
  /// any one job. Their NOC line is the same number on every job they send,
  /// and retyping it forty times is how it ends up wrong on the forty-first.
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  label String
  name  String?
  phone String?
  email String?
  note  String?
  order Int     @default(0)

  @@index([jobId])
  @@index([projectId])
  @@index([clientId])
}

enum ContactType {
  /// Manager On Duty — required, may be several.
  MOD
  /// Engineer, optional.
  NOC
  /// Project coordinator on the subcontractor side. Not our Project Manager.
  PM_PC
}

model PointOfContact {
  id    String      @id @default(cuid())
  jobId String
  job   Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type  ContactType
  name  String
  phone String?
  email String?
  order Int         @default(0)

  signatures Signature[]

  @@index([jobId, type])
}

enum SignatureKind {
  MOD
  TECH
}

model Signature {
  id    String        @id @default(cuid())
  jobId String
  job   Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind  SignatureKind

  /// Set for MOD signatures so we know which of several MODs signed.
  pointOfContactId String?
  pointOfContact   PointOfContact? @relation(fields: [pointOfContactId], references: [id], onDelete: SetNull)

  /// Set for TECH signatures.
  assignmentId String?
  assignment   JobAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  /// Denormalised for the export filename: "MOD-<Name>-Signature".
  signerName String

  attachmentId String?     @unique
  attachment   Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  /// "No Signature" was pressed.
  skipped       Boolean @default(false)
  skippedReason String?

  signedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Deliverables
// ---------------------------------------------------------------------------

enum DeliverableCategory {
  PRE_INSTALL
  POST_INSTALL
  SIGN_OFF
  ISSUES
  ADDITIONAL_INFO
  OLD_SERIALS
  NEW_SERIALS
  RETURN_LABELS
  EQUIPMENT_LEFT_ON_SITE
  CUSTOM
}

/// Which deliverable sections exist and whether they are mandatory.
/// Project-level rows are defaults; job-level rows override them.
/// Ad-hoc jobs get PRE_INSTALL + POST_INSTALL required and nothing else.
model DeliverableRequirement {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  category    DeliverableCategory
  customLabel String?

  enabled       Boolean @default(true)
  required      Boolean @default(false)
  requiresPhoto Boolean @default(true)
  requiresText  Boolean @default(false)

  order Int @default(0)

  /// One row per section per owner — except Custom Field, which a job may have
  /// several of, each with its own name. Enforced by partial unique indexes
  /// that Prisma cannot express, so they live in the migration: the fixed nine
  /// are unique on (owner, category), and custom sections on (owner, category,
  /// customLabel) so one job cannot hold two called the same thing.
  @@index([projectId])
  @@index([jobId])
}

/// A tech's contribution to one deliverable section. Kept per assignment so the
/// ZIP can be foldered by category and then by tech.
model DeliverableItem {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  assignmentId String?
  assignment   JobAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  category    DeliverableCategory
  customLabel String?
  /// Serial numbers, return label numbers, free notes.
  textValue   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]

  @@index([jobId, category])
}

// ---------------------------------------------------------------------------
// Reimbursements
// ---------------------------------------------------------------------------

enum ReimbursementType {
  MATERIAL
  PARKING
  TOLL
  HOTEL
}

model Reimbursement {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  assignmentId String?
  assignment   JobAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  type   ReimbursementType
  /// Material name, or the hotel name. Unused for PARKING/TOLL, whose export
  /// label is the type itself.
  label  String?
  amount Decimal           @db.Decimal(10, 2)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]

  @@index([jobId, type])
}

// ---------------------------------------------------------------------------
// Mileage
// ---------------------------------------------------------------------------

enum MileageCategory {
  /// Driving to a specific job; reference is that job's Assignment ID.
  IN_ROUTE_TO_WO
  /// Always available, and needs no reference.
  RETURNING_HOME
  /// Only selectable while clocked out.
  OFFCLOCK_TOOLS_SUPPLIES
  /// Only selectable while clocked in.
  ONCLOCK_TOOLS_SUPPLIES
  /// Always available; note is mandatory.
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One leg of driving, logged separately for each event: out to the job, a
/// detour for supplies, the drive home. Deliberately NOT part of payroll —
/// mileage is a write-off record for the tech's own 1099 deductions, and a
/// signal for supervisors that a tech has actually set off. Money the customer
/// puts towards travel is a separate field on the job/project.
model MileageEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("MileageOwner", fields: [userId], references: [id], onDelete: Cascade)

  category MileageCategory

  jobId     String?
  job       Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// Denormalised Assignment ID so the entry survives job edits and reads
  /// correctly in exports.
  reference String?

  startOdometer Decimal @db.Decimal(10, 1)
  endOdometer   Decimal @db.Decimal(10, 1)
  /// endOdometer - startOdometer, stored so historical rows stay stable.
  miles         Decimal @db.Decimal(10, 1)
  /// Company mileage rate at the time of entry.
  rate          Decimal @db.Decimal(10, 4)
  amount        Decimal @db.Decimal(10, 2)

  startedAt DateTime
  endedAt   DateTime

  /// Required for OTHER.
  note String?

  startPhotoId String?     @unique
  startPhoto   Attachment? @relation("MileageStartPhoto", fields: [startPhotoId], references: [id], onDelete: SetNull)
  endPhotoId   String?     @unique
  endPhoto     Attachment? @relation("MileageEndPhoto", fields: [endPhotoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Pay & payroll
// ---------------------------------------------------------------------------

enum PayType {
  HOURLY
  FLAT
  NON_BILLABLE
}

/// Rate lookup, most specific wins:
///   job override -> tech+project -> tech+client -> User.defaultPayType/Rate
model PayRate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  payType             PayType
  rate                Decimal  @db.Decimal(10, 2)
  /// Travel reimbursement is set per job/project, never as a tech default;
  /// this column only exists so a project-scoped rate row can carry it.
  travelReimbursement Decimal? @db.Decimal(10, 2)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, projectId, clientId])
  @@index([userId])
}

enum PayrollStatus {
  DRAFT
  APPROVED
  RECEIVED
  REDUCED
}

/// One Monday-start week for one tech, approved by that tech's Direct
/// Supervisor. A Manager may approve as fallback, which is recorded so the
/// supervisor can see someone else paid their tech.
model PayrollPeriod {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("PayrollTech", fields: [userId], references: [id], onDelete: Cascade)

  /// Monday 00:00 in company time zone, stored UTC.
  weekStart DateTime
  weekEnd   DateTime

  supervisorId String?
  supervisor   User?   @relation("PayrollSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  status PayrollStatus @default(DRAFT)

  expectedAmount  Decimal   @default("0") @db.Decimal(12, 2)
  receivedAmount  Decimal?  @db.Decimal(12, 2)
  receivedDate    DateTime?
  /// weekEnd + CompanySettings.payLagWeeks.
  expectedPayDate DateTime?

  approvedById       String?
  approvedBy         User?     @relation("PayrollApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  /// True when a Manager approved instead of the Direct Supervisor.
  approvedAsFallback Boolean   @default(false)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PayrollLine[]

  @@unique([userId, weekStart])
  @@index([supervisorId, weekStart])
}

model PayrollLine {
  id              String        @id @default(cuid())
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  assignmentId String
  assignment   JobAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  /// Snapshots so a later rate edit cannot rewrite history.
  payType     PayType
  payRate     Decimal @db.Decimal(10, 2)
  paidMinutes Int     @default(0)
  laborAmount Decimal @default("0") @db.Decimal(10, 2)

  travelReimb       Decimal @default("0") @db.Decimal(10, 2)
  parkingTollsReimb Decimal @default("0") @db.Decimal(10, 2)
  hotelReimb        Decimal @default("0") @db.Decimal(10, 2)
  materialsReimb    Decimal @default("0") @db.Decimal(10, 2)

  totalExpected Decimal @default("0") @db.Decimal(10, 2)

  /// Per-job override with a mandatory note.
  overrideAmount Decimal? @db.Decimal(10, 2)
  overrideNote   String?

  receivedAmount Decimal?      @db.Decimal(10, 2)
  payStatus      PayrollStatus @default(DRAFT)
  receivedDate   DateTime?
  payNote        String?

  @@unique([payrollPeriodId, assignmentId])
}

// ---------------------------------------------------------------------------
// Change requests, files, audit, notifications
// ---------------------------------------------------------------------------

/// Raised when someone without job.edit_planned_fields wants to change a
/// populated planned field. Empty planned fields are filled directly instead.
model ChangeRequest {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("ChangeRequester", fields: [requestedById], references: [id])

  fieldPath String
  oldValue  String?
  newValue  String?
  reason    String?

  status       ApprovalStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?          @relation("ChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())

  @@index([jobId, status])
  @@index([status])
}

model Attachment {
  id String @id @default(cuid())

  /// Path relative to the uploads volume.
  storagePath  String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?

  /// EXIF, kept for "was the tech actually on site" checks.
  capturedAt DateTime?
  gpsLat     Float?
  gpsLng     Float?

  watermarked Boolean @default(false)

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  deliverableItemId String?
  deliverableItem   DeliverableItem? @relation(fields: [deliverableItemId], references: [id], onDelete: Cascade)

  reimbursementId String?
  reimbursement   Reimbursement? @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  /// Set when this is paperwork attached to a job — the representing
  /// company's work order, or their sign-off blank — rather than something a
  /// tech produced on site. Kept off DeliverableItem on purpose: it is not the
  /// crew's work and must not appear in their folder of the export.
  jobDocumentId   String?
  jobDocument     Job?             @relation("JobDocuments", fields: [jobDocumentId], references: [id], onDelete: Cascade)
  jobDocumentKind JobDocumentKind?

  /// Set when this is a blank kept against a representing company.
  clientTemplate ClientDocumentTemplate? @relation("ClientTemplateFile")

  /// The company blank this file came from, whether copied onto the job as-is
  /// or generated by filling it in. Without it a job cannot tell which set of
  /// box positions belongs to the sheet it is holding.
  sourceTemplateId String?
  sourceTemplate   ClientDocumentTemplate? @relation("TemplateCopies", fields: [sourceTemplateId], references: [id], onDelete: SetNull)

  /// True on a sheet the app filled in. Regenerable by definition: it is the
  /// blank plus the job as it stood, so a later one replaces it rather than
  /// piling up beside it.
  generated Boolean @default(false)

  signature         Signature?
  mileageStartEntry MileageEntry? @relation("MileageStartPhoto")
  mileageEndEntry   MileageEntry? @relation("MileageEndPhoto")

  @@index([deliverableItemId])
  @@index([reimbursementId])
  @@index([jobDocumentId])
}

model AuditEvent {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String
  action     String
  /// Free shape, but the timeline reads these keys when they are present:
  /// field, from, to, who, reason, count.
  detail     Json?

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

/// Something that happened to somebody rather than something they must decide.
///
/// Being put on a job, taken off one, or made a project's coordinator are not
/// approvals — there is nothing to accept or reject — but they are also not
/// things to find out about by noticing your schedule changed. So they are
/// listed separately and wait for an acknowledgement, which is what makes
/// "they were told" a fact rather than an assumption.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Who caused it. Null for anything the system did on its own.
  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  kind  String
  title String
  body  String?
  /// In-app deep link.
  href  String?

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  acknowledgedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, acknowledgedAt])
  @@index([userId, createdAt])
}

/// What has been pushed to a tech's NextCloud calendar.
///
/// Sync is one-way, so this is the only record of what is out there: without
/// it an unassignment could not be turned into a DELETE, and every save would
/// re-upload an unchanged event. The hash is what makes a no-op push free.
model CalendarEvent {
  id String @id @default(cuid())

  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Absolute URL of the .ics on the CalDAV server.
  calendarPath String
  /// Incremented on every change so clients notice the update.
  sequence     Int    @default(0)
  /// Digest of the last body written; an identical rebuild is skipped.
  contentHash  String

  syncedAt DateTime @default(now())

  @@unique([jobId, userId])
  @@index([userId])
}

/// Yearly global counter for jobs with no project. Project-scoped counters live
/// on Project.intWoCounter.
model IntWoCounter {
  /// "global:2026"
  scope String @id
  value Int    @default(0)
}
