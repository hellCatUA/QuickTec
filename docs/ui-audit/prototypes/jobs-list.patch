+"use client";
+
+import { ChevronRight, Search, UsersRound } from "lucide-react";
+import Link from "next/link";
+import * as React from "react";
+import { Badge } from "@/components/ui/badge";
+import { cn } from "@/lib/utils";
+
+type Variant = "neutral" | "primary" | "success" | "warning" | "danger";
+
+export type JobRow = {
+  id: string;
+  title: string;
+  revisit: number | null;
+  /** "7:30 AM" on the site's clock, or null when there is no date yet. */
+  time: string | null;
+  /** "Sat 11/7" or "Today", in a group that holds more than one day. */
+  day: string | null;
+  /** "SBUX #10542 · Visalia, CA" */
+  place: string;
+  badges: { label: string; variant: Variant }[];
+  /** The lead and how many more: "Terry Tech +1", "You +2", or null. */
+  crew: string | null;
+  unassigned: boolean;
+  /** "2611-SBX-POS-0005 · NetCom Sub" — ours, and who pays. */
+  reference: string;
+  /** Everything it can be found by, lower case. */
+  search: string;
+};
+
+export type JobGroup = { key: string; label: string; jobs: JobRow[] };
+
+/**
+ * The jobs, a day at a time.
+ *
+ * The date used to open every card's second line, and a card carried two
+ * reference numbers and the paying company as well — four lines and up to four
+ * badges for each job, so a phone showed five or six of them and the eye had
+ * to read every one to find today. Now the day is a heading said once, the
+ * card is the time, what it is, where, and how it stands, and the numbers
+ * are what the search box finds rather than what every card spells out.
+ */
+export function JobList({
+  groups,
+  searchable,
+}: {
+  groups: JobGroup[];
+  /** Only for a list long enough to need it. */
+  searchable: boolean;
+}) {
+  const [query, setQuery] = React.useState("");
+  const needle = query.trim().toLowerCase();
+
+  const shown = groups
+    .map((group) => ({
+      ...group,
+      jobs: needle
+        ? group.jobs.filter((job) => job.search.includes(needle))
+        : group.jobs,
+    }))
+    .filter((group) => group.jobs.length > 0);
+  const count = shown.reduce((total, group) => total + group.jobs.length, 0);
+
+  return (
+    <div className="flex flex-col gap-4">
+      {searchable ? (
+        <label className="relative block">
+          <span className="sr-only">Find a job</span>
+          <Search className="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
+          <input
+            type="search"
+            value={query}
+            onChange={(event) => setQuery(event.target.value)}
+            placeholder="WO, title, site, city or crew"
+            autoComplete="off"
+            className="min-h-11 w-full rounded-lg border border-border bg-input pl-9 pr-3 text-foreground placeholder:text-muted-foreground"
+          />
+        </label>
+      ) : null}
+
+      <p className="sr-only" aria-live="polite">
+        {needle ? `${count} ${count === 1 ? "job" : "jobs"} found` : null}
+      </p>
+      {needle && count === 0 ? (
+        <p className="text-sm text-muted-foreground">Nothing matches that.</p>
+      ) : null}
+
+      {shown.map((group) => (
+        <section key={group.key} className="flex flex-col gap-2">
+          <h2 className="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
+            {group.label}
+            <span className="tabular rounded-full bg-muted px-1.5 py-px text-[0.6875rem] font-medium normal-case tracking-normal">
+              {group.jobs.length}
+            </span>
+          </h2>
+          {group.jobs.map((job) => (
+            <JobCard key={job.id} job={job} />
+          ))}
+        </section>
+      ))}
+    </div>
+  );
+}
+
+function JobCard({ job }: { job: JobRow }) {
+  return (
+    <Link
+      href={`/jobs/${job.id}`}
+      className="flex items-start gap-3 rounded-xl border border-border bg-surface p-3 transition-colors hover:border-primary/50"
+    >
+      {/* The time has a column of its own: it is what the list is scanned
+          by, and it never shares a line with anything that could push it
+          off the end. */}
+      <div className="tabular flex w-[4.25rem] shrink-0 flex-col pt-px text-sm font-semibold leading-tight">
+        {job.day ? (
+          <span className="text-xs font-medium text-muted-foreground">
+            {job.day}
+          </span>
+        ) : null}
+        <span className={job.time ? undefined : "text-muted-foreground"}>
+          {job.time ?? "—"}
+        </span>
+      </div>
+
+      <div className="flex min-w-0 flex-1 flex-col gap-0.5">
+        <div className="flex items-start gap-1.5">
+          <span className="line-clamp-2 text-sm font-semibold leading-snug">
+            {job.title}
+          </span>
+          {job.revisit ? (
+            <Badge variant="warning" className="shrink-0">
+              R{job.revisit}
+            </Badge>
+          ) : null}
+        </div>
+        <span className="truncate text-xs text-muted-foreground">
+          {job.place}
+        </span>
+
+        {/* How it stands and who is on it, under the title rather than
+            beside it: three badges beside a title on a phone used to fold
+            the title into a column three words wide. */}
+        <div
+          className={cn(
+            "mt-1 flex-wrap items-center gap-x-2 gap-y-1 text-xs",
+            job.badges.length > 0 || job.unassigned || job.crew
+              ? "flex"
+              : "hidden sm:flex",
+          )}
+        >
+          {job.badges.map((badge) => (
+            <Badge key={badge.label} variant={badge.variant}>
+              {badge.label}
+            </Badge>
+          ))}
+          {job.unassigned ? (
+            <span className="inline-flex items-center gap-1 text-warning">
+              <UsersRound className="size-3.5" aria-hidden />
+              Nobody assigned
+            </span>
+          ) : job.crew ? (
+            <span className="inline-flex min-w-0 items-center gap-1 text-muted-foreground">
+              <UsersRound className="size-3.5 shrink-0" aria-hidden />
+              <span className="sr-only">Lead:</span>
+              <span className="truncate">{job.crew}</span>
+            </span>
+          ) : null}
+          {/* Ours and who pays, for whoever quotes them — from a tablet up,
+              where they fit without taking a line. On a phone the search
+              finds them. */}
+          <span className="tabular hidden min-w-0 truncate text-muted-foreground sm:inline">
+            {job.reference}
+          </span>
+        </div>
+      </div>
+
+      <ChevronRight className="mt-0.5 size-4 shrink-0 text-muted-foreground" />
+    </Link>
+  );
+}
