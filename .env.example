# Copy to .env and fill in. docker-compose reads this file.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=quicktec
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quicktec

# Host "db" is the compose service name. Use localhost:5432 for local dev.
DATABASE_URL=postgresql://quicktec:change-me@db:5432/quicktec?schema=public

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Public URL of the app, as seen through Nginx Proxy Manager.
AUTH_URL=https://quicktec.417group.org
# openssl rand -base64 32
AUTH_SECRET=

# NextCloud with the "OpenID Connect provider" app installed.
NEXTCLOUD_ISSUER=https://cloud.417group.org
# Optional. Defaults to <issuer>/index.php/apps/oidc/openid-configuration
NEXTCLOUD_WELL_KNOWN=
NEXTCLOUD_CLIENT_ID=
NEXTCLOUD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Calendar sync (optional)
# ---------------------------------------------------------------------------
# The system NextCloud account that owns every tech calendar. Use an app
# password, not the account password. Leave blank to disable sync.
CALDAV_USERNAME=417-sys
CALDAV_PASSWORD=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Where photos, signatures and generated exports are written inside the
# container. Bind-mounted to a dataset on OMV in docker-compose.yml.
UPLOADS_DIR=/data/uploads

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
TZ=America/Los_Angeles
NODE_ENV=production
APP_PORT=3000
