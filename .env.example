# Copy to .env and fill in. docker-compose reads this file.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Generate with `openssl rand -hex 24`, NOT base64. This value ends up inside a
# connection string, where a "/" terminates the host part and fails with
# "invalid port number". Hex has no character that needs escaping.
POSTGRES_USER=quicktec
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quicktec

# DATABASE_URL is built from the three variables above by docker-compose.yml —
# leave it unset and there is only ever one copy of the password to get wrong.
#
# Set it only to reach a Postgres that compose does not run: an external server,
# or a local one during development. It wins over the derived value.
# DATABASE_URL=postgresql://quicktec:change-me@localhost:5432/quicktec?schema=public

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Public URL of the app, as seen through Nginx Proxy Manager.
AUTH_URL=https://quicktec.417group.org
# openssl rand -base64 32
AUTH_SECRET=

# NextCloud with the "OpenID Connect provider" app installed.
NEXTCLOUD_ISSUER=https://cloud.417group.org
# Optional. Defaults to <issuer>/index.php/apps/oidc/openid-configuration
NEXTCLOUD_WELL_KNOWN=
NEXTCLOUD_CLIENT_ID=
NEXTCLOUD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Calendar sync (optional)
# ---------------------------------------------------------------------------
# The system NextCloud account that owns every tech calendar. Use an app
# password, not the account password. Leave blank to disable sync.
CALDAV_USERNAME=417-sys
CALDAV_PASSWORD=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Where photos, signatures and generated exports are written inside the
# container. Leave this alone — it is the path the app writes to.
UPLOADS_DIR=/data/uploads

# Where those two live on the host.
#
# Postgres stays beside docker-compose.yml — it is small, and it is restored
# from a dump rather than from a file copy. Relative on purpose: it then
# follows the checkout wherever it lives, instead of naming a path that is
# right on one host and a different directory on the next.
POSTGRES_DIR=./data/postgres

# Photos, signatures and generated exports. This one goes on the pool, where
# OMV's snapshots reach it — it is the only data here that cannot be rebuilt.
#
# It MUST exist and belong to uid 1001 before the first upload. Docker creates
# a missing bind-mount source as root and the app runs unprivileged, so a path
# Docker makes for you is a path it cannot write to:
#
#   mkdir -p /tank/data/quicktec/uploads
#   chown -R 1001:1001 /tank/data/quicktec/uploads
UPLOADS_HOST_DIR=/tank/data/quicktec/uploads

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
TZ=America/Los_Angeles
NODE_ENV=production

# Host port, and the one to enter in the reverse proxy. Nginx Proxy Manager
# running with network_mode: host already occupies 3000 with its own API —
# check with `ss -ltnp | grep :3000` and move this if it is taken.
APP_PORT=3000
