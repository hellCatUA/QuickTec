node_modules/
.next/
out/
build/
dist/

# Prisma client is generated at build time.
/generated/

# Keep environment variables out of version control
.env
.env.local
.env.*.local

*.log
npm-debug.log*
.DS_Store
.vscode/
.idea/

next-env.d.ts
*.tsbuildinfo

# Runtime data — lives on the host volume, never in git.
data/
uploads/

# Site-specific compose additions (extra_hosts, a different bind address).
docker-compose.override.yml

# The assembled design canvas: the artboards beside it are the source, and this
# is them wrapped in ~2.5 MB of editor bundle, rebuilt from scratch on every
# change.
/design/**/*-redesign.html

# Generated by `prisma init` — regenerable reference docs for AI assistants.
.agents/
.claude/
.windsurf/
skills-lock.json
